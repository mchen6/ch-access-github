{
  "name": "@countinghouse/ch-access-github",
  "version": "0.2.1",
  "description": "countinghouse access module for GitHub: workflow runs, failed jobs, job logs and commits through GitHub's remote MCP server, read-only, with a personal access token that the runtime sends to GitHub and this module never sees.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mchen6/ch-access-github.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "api.json",
    "schema.json",
    "handlers/",
    "lib/"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "validate": "node scripts/validate.js"
  },
  "countinghouse": {
    "role": "part",
    "remotes": [
      {
        "name": "github",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "X-MCP-Toolsets": "actions,repos",
          "X-MCP-Readonly": "true",
          "X-MCP-Tools": "actions_list,get_job_logs,list_commits"
        },
        "credential": "GITHUB_TOKEN"
      }
    ]
  },
  "devDependencies": {
    "countinghouse": "git+https://github.com/mchen6/countinghouse.git#c26b9fcbe484a0fb4f902ab6d45ec2062f20bf33"
  },
  "allowScripts": {
    "dtrace-provider": false,
    "msgpackr-extract": false,
    "sqlite3": false
  }
}
